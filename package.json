{
  "name": "timetracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src/ && eslint . --cache",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "knip": "knip",
    "e2e": "playwright test",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "husky",
    "electron:icons": "node scripts/generate-icons.mjs",
    "electron:dev": "npm run electron:icons && wait-on http://timetracker.localhost:5173 && NODE_ENV=development electron .",
    "electron:build": "npm run electron:icons && npm run build && electron-builder",
    "start": "concurrently --kill-others-on-fail \"npm run dev\" \"npm run electron:dev\"",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.10.1",
    "@azure/msal-react": "^5.4.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "electron-auto-launch": "^5.0.7",
    "exceljs": "^4.4.0",
    "msw": "^2.14.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.6",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^1.68.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "lint-staged": "^17.0.5",
    "oxlint": "^1.68.0",
    "prettier": "^3.8.3",
    "react-doctor": "^0.9.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.coremedia.timetracker",
    "productName": "Timetracker",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/favicon.svg"
    ],
    "icon": "electron/icons/app",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/icons/app.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/icons/app.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "electron/icons/512x512.png",
      "target": [
        "AppImage"
      ]
    }
  },
  "overrides": {
    "qs": "^6.15.2",
    "uuid": "^11.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
